{
  "expo": {
    "name": "OVbord",
    "slug": "ovspot",
    "scheme": "ovbord",
    "version": "1.0.5",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "OVbord gebruikt je locatie om haltes in de buurt te tonen."
        }
      ],
      ["react-native-android-widget", {
        "widgets": [{
          "name": "MijnHalte",
          "label": "OVbord · Mijn halte",
          "description": "Eerstvolgende vertrekken van je eerste favoriete halte",
          "minWidth": "250dp",
          "minHeight": "135dp",
          "targetCellWidth": 4,
          "targetCellHeight": 3,
          "resizeMode": "horizontal|vertical",
          "updatePeriodMillis": 1800000
        }]
      }],
      ["expo-notifications", { "color": "#185c98" }]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "nl.ovbord.app"
    },
    "android": {
      "package": "nl.ovbord.app",
      "versionCode": 6,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "879efc14-e217-4ba5-b9a0-468ef855b9ed"
      }
    },
    "owner": "ovspots-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/879efc14-e217-4ba5-b9a0-468ef855b9ed",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
